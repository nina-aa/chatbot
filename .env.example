OPENAI_API_KEY="sk-proj-your-key-here"
GOOGLE_API_KEY="your-gemini-key-here"

# Optional overrides (defaults live in docrag/config.py)
# Fallback chain: on 429/404/503 the next model is tried immediately.
# GEMINI_MODELS="gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-pro"
# GEMMA_MODEL="gemma-4-26b-a4b-it"
# GEMINI_TIMEOUT_S=120
# OPENAI_CHAT_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Vector store: "numpy" (default, files in data/index) or "pgvector" (Postgres).
# `docker compose up -d` starts a matching database. Can also be chosen per command with --store.
# STORE="numpy"
# DATABASE_URL="postgresql://docrag:docrag@localhost:5433/docrag"
